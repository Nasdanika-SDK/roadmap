@Ecore(nsURI="https://ai.models.nasdanika.org", nsPrefix="org.nasdanika.models.governance.ai")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.governance.ai

import org.nasdanika.models.governance.Assessment
import org.nasdanika.models.governance.Control
import org.nasdanika.models.governance.Evidence
import org.nasdanika.models.governance.Governed
import org.nasdanika.models.governance.Level
import org.nasdanika.models.nxcore.ModelElement
import org.nasdanika.models.governance.Risk

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* ---- AI systems ---- */

/* EU AI Act risk tiers. NOT_ASSESSED is the honest default. */
enum AiActRiskTier {
    NOT_ASSESSED
    /* Art. 5 prohibited practices. */
    UNACCEPTABLE
    /* Annex III and product-safety high-risk systems. */
    HIGH
    /* Transparency obligations, e.g. chatbots, deepfakes. */
    LIMITED
    MINIMAL
}

/* The organization's role with respect to a system under the EU AI Act. */
enum AiActActorRole {
    PROVIDER
    DEPLOYER
    IMPORTER
    DISTRIBUTOR
}

/*
 * An AI system as a governed element: the unit that regulators, risk
 * registers, and inventories talk about. Composition of the system
 * (agents, models, tools, MCP servers) belongs to the agent and MCP
 * models; those elements are themselves governable.
 */
class AISystem extends Governed {
    /* Markdown statement of purpose and intended use. */
    String intendedUse
    /* Uses explicitly out of scope; misuse boundary. */
    String[] prohibitedUses
    AiActRiskTier riskTier
    AiActActorRole actorRole
    /* General-purpose AI model obligations may apply. */
    boolean generalPurpose
    contains ModelAsset[] models
    contains DatasetAsset[] datasets
}

/* A model used by a system: the inventory entry, not the runtime wiring. */
class ModelAsset extends Governed {
    /* Provider, e.g. anthropic, openai, internal. */
    String provider
    String version
    /* Modality or task, e.g. text generation, classification, embedding. */
    String modality
    boolean openWeights
}

/* A dataset used for training, tuning, evaluation, or retrieval. */
class DatasetAsset extends Governed {
    /* Markdown provenance: origin, collection method, transformations. */
    String provenance
    boolean personalData
    String license
}

/* ---- AI risk taxonomy ---- */

/*
 * Common AI risk categories, drawn from the AI RMF, the AIGP Body of
 * Knowledge, and the OWASP LLM/agentic risk catalogs. Free-form category
 * remains available on the base Risk for anything not listed.
 */
enum AiRiskCategory {
    BIAS_DISCRIMINATION
    PRIVACY
    /* Prompt injection, data exfiltration, model theft, supply chain. */
    SECURITY
    HALLUCINATION
    TOXICITY
    IP_COPYRIGHT
    /* Users unaware they interact with or are affected by AI. */
    TRANSPARENCY
    SAFETY
    /* Silent degradation of model or data over time. */
    DRIFT
    /* Deliberate use outside the intended purpose. */
    MISUSE
    /* Excessive delegation to agents; rubber-stamped oversight. */
    OVERRELIANCE
}

class AIRisk extends Risk {
    AiRiskCategory aiCategory
}

/* ---- Impact assessments ---- */

enum ImpactAssessmentKind {
    /* Algorithmic / AI impact assessment. */
    AI_IMPACT
    /* Data protection impact assessment (GDPR Art. 35). */
    DATA_PROTECTION
    /* Fundamental rights impact assessment (EU AI Act Art. 27). */
    FUNDAMENTAL_RIGHTS
}

/*
 * An impact assessment as a specialized assessment: same findings and
 * evidence mechanics, plus the affected-stakeholder view that
 * distinguishes impact assessments from audits.
 */
class ImpactAssessment extends Assessment {
    ImpactAssessmentKind kind
    /* Affected stakeholder groups: applicants, employees, minors, the public. */
    String[] stakeholders
}

/* ---- Human oversight ---- */

enum OversightMode {
    /* A human approves each consequential action before it takes effect. */
    HUMAN_IN_THE_LOOP
    /* A human monitors and can intervene; actions proceed by default. */
    HUMAN_ON_THE_LOOP
    /* A human retains overall authority: kill switch, scope changes. */
    HUMAN_IN_COMMAND
}

/* Human oversight as a typed control (EU AI Act Art. 14, AI RMF MANAGE). */
class HumanOversightControl extends Control {
    OversightMode mode
}

/* ---- AI-typed evidence ---- */

/* A model card or fact sheet; format examples: Hugging Face card, CycloneDX ML-BOM, SPDX AI profile. */
class ModelCard extends Evidence {
    String format
}

enum EvaluationKind {
    BENCHMARK
    /* Task-specific evals, golden sets. */
    CAPABILITY
    RED_TEAM
    /* Fairness / bias measurement. */
    BIAS
    SAFETY
}

/* An evaluation run as evidence: what was measured and what it scored. */
class Evaluation extends Evidence {
    EvaluationKind kind
    /* Metric name, e.g. accuracy, refusal rate, demographic parity. */
    String metric
    String score
    String threshold
    boolean passed
}

/*
 * Telemetry-backed evidence: a query over modeled telemetry with a threshold.
 * This is continuous control monitoring via telemetry as code; collection is
 * automated by construction.
 */
class TelemetryEvidence extends Evidence {
    /* Metric or signal name. */
    String metric
    /* Query expression against the telemetry backend. */
    String query
    String threshold
}

/* ---- Incidents ---- */

enum IncidentStatus {
    REPORTED
    INVESTIGATING
    MITIGATED
    RESOLVED
}

/*
 * An AI incident or serious malfunction: the record behind EU AI Act
 * serious-incident reporting and internal post-mortems.
 */
class Incident extends ModelElement {
    Date occurred
    Level severity
    IncidentStatus status
    refers AISystem system
    /* Reportable to a regulator, e.g. EU AI Act Art. 73. */
    boolean reportable
    /* Corrective controls introduced or strengthened in response. */
    refers Control[] correctiveActions
}

