@xcore.lang.GenModel(documentation="3.0.0+\r\nThis element describes all of the mailing lists associated with a project. The\n        auto-generated site references this information.")
@xcore.lang.ExtendedMetaData(name="MailingList", kind="elementOnly")
class MailingList {
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The name of the mailing list.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The email address or link that can be used to subscribe to\n            the mailing list.  If this is an email address, a\n            <code>mailto:</code> link will automatically be created\n            when the documentation is created.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="subscribe", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String subscribe
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The email address or link that can be used to unsubscribe to\n            the mailing list.  If this is an email address, a\n            <code>mailto:</code> link will automatically be created\n            when the documentation is created.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="unsubscribe", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String unsubscribe
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The email address or link that can be used to post to\n            the mailing list.  If this is an email address, a\n            <code>mailto:</code> link will automatically be created\n            when the documentation is created.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="post", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String post
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe link to a URL where you can browse the mailing list archive.")
	@xcore.lang.ExtendedMetaData(kind="element", name="archive", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String archive
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe link to alternate URLs where you can browse the list archive.")
	@xcore.lang.ExtendedMetaData(kind="element", name="otherArchives", namespace="##targetNamespace")
	contains OtherArchivesType otherArchives
}

@xcore.lang.ExtendedMetaData(name="mailingLists_._type", kind="elementOnly")
class MailingListsType {
