@xcore.lang.GenModel(documentation="4.0.0+\r\n\n        \n        The <code>&lt;scm&gt;</code> element contains informations required to the SCM\n        (Source Control Management) of the project.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="Scm", kind="elementOnly")
class Scm {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The source control management system URL\n            that describes the repository and how to connect to the\n            repository. For more information, see the\n            <a href=\"https://maven.apache.org/scm/scm-url-format.html\">URL format</a>\n            and <a href=\"https://maven.apache.org/scm/scms-overview.html\">list of supported SCMs</a>.\n            This connection is read-only.\n            <br><b>Default value is</b>: parent value [+ path adjustment] + (artifactId or project.directory property), or just parent value if\n            scm\'s <code>child.scm.connection.inherit.append.path=\"false\"</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="connection", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String connection
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Just like <code>connection</code>, but for developers, i.e. this scm connection\n            will not be read only.\n            <br><b>Default value is</b>: parent value [+ path adjustment] + (artifactId or project.directory property), or just parent value if\n            scm\'s <code>child.scm.developerConnection.inherit.append.path=\"false\"</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="developerConnection", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String developerConnection
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe tag of current code. By default, it\'s set to HEAD during development.")
	@xcore.lang.ExtendedMetaData(kind="element", name="tag", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String tag = "HEAD"
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The URL to the project\'s browsable SCM repository, such as ViewVC or Fisheye.\n            <br><b>Default value is</b>: parent value [+ path adjustment] + (artifactId or project.directory property), or just parent value if\n            scm\'s <code>child.scm.url.inherit.append.path=\"false\"</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            When children inherit from scm connection, append path or not? Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>\n            <br><b>Default value is</b>: <code>true</code>\n            <br><b>Since</b>: Maven 3.6.1\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="attribute", name="child.scm.connection.inherit.append.path")
	org.eclipse.emf.ecore.xml.^type.String childScmConnectionInheritAppendPath
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            When children inherit from scm developer connection, append path or not? Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>\n            <br><b>Default value is</b>: <code>true</code>\n            <br><b>Since</b>: Maven 3.6.1\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="attribute", name="child.scm.developerConnection.inherit.append.path")
	org.eclipse.emf.ecore.xml.^type.String childScmDeveloperConnectionInheritAppendPath
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            When children inherit from scm url, append path or not? Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>\n            <br><b>Default value is</b>: <code>true</code>\n            <br><b>Since</b>: Maven 3.6.1\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="attribute", name="child.scm.url.inherit.append.path")
	org.eclipse.emf.ecore.xml.^type.String childScmUrlInheritAppendPath
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nContains the information needed for deploying websites.")
@xcore.lang.ExtendedMetaData(name="Site", kind="elementOnly")
class Site {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            A unique identifier for a deployment location. This is used to match the\n            site to configuration in the <code>settings.xml</code> file, for example.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="id", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String ^id
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHuman readable name of the deployment location.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The url of the location where website is deployed, in the form <code>protocol://hostname/path</code>.\n            <br><b>Default value is</b>: parent value [+ path adjustment] + (artifactId or project.directory property), or just parent value if\n            site\'s <code>child.site.url.inherit.append.path=\"false\"</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            When children inherit from distribution management site url, append path or not? Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>\n            <br><b>Default value is</b>: <code>true</code>\n            <br><b>Since</b>: Maven 3.6.1\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="attribute", name="child.site.url.inherit.append.path")
	org.eclipse.emf.ecore.xml.^type.String childSiteUrlInheritAppendPath
}

