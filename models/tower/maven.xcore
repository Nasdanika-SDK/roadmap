@xcore.lang.GenModel(documentation="3.0.0+\r\nDescription of a person who has contributed to the project, but who does not have\n        commit privileges. Usually, these contributions come in the form of patches submitted.")
@xcore.lang.ExtendedMetaData(name="Contributor", kind="elementOnly")
class Contributor {
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe full name of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe email address of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="email", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String email
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe URL for the homepage of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe organization to which the contributor belongs.")
	@xcore.lang.ExtendedMetaData(kind="element", name="organization", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String organization
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe URL of the organization.")
	@xcore.lang.ExtendedMetaData(kind="element", name="organizationUrl", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String organizationUrl
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The roles the contributor plays in the project. Each role is described by a\n            <code>role</code> element, the body of which is a role name. This can also be used to\n            describe the contribution.\n            \n          ",
		property="Editable", children="false", createChild="false")
	@xcore.lang.ExtendedMetaData(kind="element", name="roles", namespace="##targetNamespace")
	contains RolesType roles
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n              The timezone the contributor is in. Typically, this is a number in the range\n              <a href=\"http://en.wikipedia.org/wiki/UTC%E2%88%9212:00\">-12</a> to <a href=\"http://en.wikipedia.org/wiki/UTC%2B14:00\">+14</a>\n              or a valid time zone id like \"America/Montreal\" (UTC-05:00) or \"Europe/Paris\" (UTC+01:00).\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="timezone", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String timezone
	@xcore.lang.GenModel(documentation="3.0.0+\r\nProperties about the contributor, such as an instant messenger handle.")
	@xcore.lang.ExtendedMetaData(kind="element", name="properties", namespace="##targetNamespace")
	contains PropertiesType2 properties
}

@xcore.lang.ExtendedMetaData(name="contributors_._type", kind="elementOnly")
class ContributorsType {
	@xcore.lang.ExtendedMetaData(kind="element", name="contributor", namespace="##targetNamespace")
	contains Contributor[] contributor
}

