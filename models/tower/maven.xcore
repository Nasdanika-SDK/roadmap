	org.eclipse.emf.ecore.xml.^type.String groupId
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe new artifact ID of the artifact.")
	@xcore.lang.ExtendedMetaData(kind="element", name="artifactId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String artifactId
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe new version of the artifact.")
	@xcore.lang.ExtendedMetaData(kind="element", name="version", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String version
	@xcore.lang.GenModel(documentation="4.0.0+\r\nAn additional message to show the user about the move, such as the reason.")
	@xcore.lang.ExtendedMetaData(kind="element", name="message", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String message
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nSection for management of reports and their configuration.")
@xcore.lang.ExtendedMetaData(name="Reporting", kind="elementOnly")
class Reporting {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            If true, then the default reports are not included in the site generation.\n            This includes the reports in the \"Project Info\" menu. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>false</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="excludeDefaults", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String excludeDefaults
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Where to store all of the generated reports. The default is\n            <code>${project.build.directory}/site</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="outputDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String outputDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe reporting plugins to use and their configuration.")
	@xcore.lang.ExtendedMetaData(kind="element", name="plugins", namespace="##targetNamespace")
	contains PluginsType2 plugins
}

@xcore.lang.GenModel(documentation="4.0.0+\r\n\n        \n        The <code>&lt;plugin&gt;</code> element in <code>&lt;reporting&gt;&lt;plugins&gt;</code> contains informations required for a report plugin.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="ReportPlugin", kind="elementOnly")
class ReportPlugin {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe group ID of the reporting plugin in the repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="groupId", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String groupId = "org.apache.maven.plugins"
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe artifact ID of the reporting plugin in the repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="artifactId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] artifactId
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The version of the reporting plugin to be used. Starting with Maven 3, if no version is defined explicitely,\n            version is searched in <code>build/plugins</code> then in <code>build/pluginManagement</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="version", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String version
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Multiple specifications of a set of reports, each having (possibly) different\n            configuration. This is the reporting parallel to an <code>execution</code> in the build.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="reportSets", namespace="##targetNamespace")
	contains ReportSetsType reportSets
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Whether any configuration should be propagated to child POMs. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>true</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="inherited", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String inherited
	@xcore.lang.GenModel(documentation="0.0.0+\r\n\n            \n            <p>The configuration as DOM object.</p>\n            <p>By default, every element content is trimmed, but starting with Maven 3.1.0, you can add\n            <code>xml:space=\"preserve\"</code> to elements you want to preserve whitespace.</p>\n            <p>You can control how child POMs inherit configuration from parent POMs by adding <code>combine.children</code>\n            or <code>combine.self</code> attributes to the children of the configuration element:</p>\n            <ul>\n            <li><code>combine.children</code>: available values are <code>merge</code> (default) and <code>append</code>,</li>\n            <li><code>combine.self</code>: available values are <code>merge</code> (default) and <code>override</code>.</li>\n            </ul>\n            <p>See <a href=\"https://maven.apache.org/pom.html#Plugins\">POM Reference documentation</a> and\n            <a href=\"https://codehaus-plexus.github.io/plexus-utils/apidocs/org/codehaus/plexus/util/xml/Xpp3DomUtils.html\">Xpp3DomUtils</a>\n            for more information.</p>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="configuration", namespace="##targetNamespace")
	contains ConfigurationType1 configuration
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nRepresents a set of reports and configuration to be used to generate them.")
@xcore.lang.ExtendedMetaData(name="ReportSet", kind="elementOnly")
class ReportSet {
	@xcore.lang.GenModel(documentation="0.0.0+\r\nThe unique id for this report set, to be used during POM inheritance and profile injection\n            for merging of report sets.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="id", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String ^id = "default"
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe list of reports from this plugin which should be generated from this set.")
	@xcore.lang.ExtendedMetaData(kind="element", name="reports", namespace="##targetNamespace")
	contains ReportsType reports
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Whether any configuration should be propagated to child POMs. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>true</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="inherited", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String inherited
	@xcore.lang.GenModel(documentation="0.0.0+\r\n\n            \n            <p>The configuration as DOM object.</p>\n            <p>By default, every element content is trimmed, but starting with Maven 3.1.0, you can add\n            <code>xml:space=\"preserve\"</code> to elements you want to preserve whitespace.</p>\n            <p>You can control how child POMs inherit configuration from parent POMs by adding <code>combine.children</code>\n            or <code>combine.self</code> attributes to the children of the configuration element:</p>\n            <ul>\n            <li><code>combine.children</code>: available values are <code>merge</code> (default) and <code>append</code>,</li>\n            <li><code>combine.self</code>: available values are <code>merge</code> (default) and <code>override</code>.</li>\n            </ul>\n            <p>See <a href=\"https://maven.apache.org/pom.html#Plugins\">POM Reference documentation</a> and\n            <a href=\"https://codehaus-plexus.github.io/plexus-utils/apidocs/org/codehaus/plexus/util/xml/Xpp3DomUtils.html\">Xpp3DomUtils</a>\n            for more information.</p>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="configuration", namespace="##targetNamespace")
	contains ConfigurationType2 configuration
}

