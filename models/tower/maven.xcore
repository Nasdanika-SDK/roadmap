class DependenciesType1 {
	@xcore.lang.ExtendedMetaData(kind="element", name="dependency", namespace="##targetNamespace")
	contains Dependency[] dependency
}

@xcore.lang.ExtendedMetaData(name="dependencies_._2_._type", kind="elementOnly")
class DependenciesType2 {
	@xcore.lang.ExtendedMetaData(kind="element", name="dependency", namespace="##targetNamespace")
	contains Dependency[] dependency
}

@xcore.lang.ExtendedMetaData(name="dependencies_._3_._type", kind="elementOnly")
class DependenciesType3 {
	@xcore.lang.ExtendedMetaData(kind="element", name="dependency", namespace="##targetNamespace")
	contains Dependency[] dependency
}

@xcore.lang.GenModel(documentation="3.0.0+\r\n\n        \n        The <code>&lt;dependency&gt;</code> element contains information about a dependency\n        of the project.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="Dependency", kind="elementOnly")
class Dependency {
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The project group that produced the dependency, e.g.\n            <code>org.apache.maven</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="groupId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] groupId
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The unique id for an artifact produced by the project group, e.g.\n            <code>maven-artifact</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="artifactId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] artifactId
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The version requirement of the dependency such as <code>3.2.1</code>.\n            The actual version will be resolved by dependency mediation.\n            The version requirement can also be\n            specified as a range of versions such as <code>[3.2.0,)</code>.\n            However, this is discouraged since it may break <i>predictability</i> of\n            the resolved version. See the <a href=\"https://maven.apache.org/pom.html#Dependency_Version_Requirement_Specification\">Dependency Version Requirement Specification</a>\n            and <a href=\"https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html#Transitive_Dependencies\">Transitive Dependencies</a> for more details.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="version", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String version
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The type of dependency, that will be mapped to a file extension, an optional classifier, and a few other attributes.\n            Some examples are <code>jar</code>, <code>war</code>, <code>ejb-client</code>\n            and <code>test-jar</code>: see <a href=\"../maven-core/artifact-handlers.html\">default\n            artifact handlers</a> for a list. New types can be defined by extensions, so this is not a complete list.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="type", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String ^type = "jar"
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The classifier of the dependency. It is appended to\n            the filename after the version. This allows:\n            <ul>\n            <li>referring to attached artifact, for example <code>sources</code> and <code>javadoc</code>:\n            see <a href=\"../maven-core/artifact-handlers.html\">default artifact handlers</a> for a list,</li>\n            <li>distinguishing two artifacts\n            that belong to the same POM but were built differently.\n            For example, <code>jdk14</code> and <code>jdk15</code>.</li>\n            </ul>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="classifier", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String classifier
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The scope of the dependency - <code>compile</code>, <code>runtime</code>,\n            <code>test</code>, <code>system</code>, and <code>provided</code>. Used to\n            calculate the various classpaths used for compilation, testing, and so on.\n            It also assists in determining which artifacts to include in a distribution of\n            this project. For more information, see\n            <a href=\"https://maven.apache.org/guides/introduction/introduction-to-dependency-mechanism.html\">the\n            dependency mechanism</a>. The default scope is <code>compile</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="scope", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String scope
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            FOR SYSTEM SCOPE ONLY. Note that use of this property is <b>discouraged</b>\n            and may be replaced in later versions. This specifies the path on the filesystem\n            for this dependency.\n            Requires an absolute path for the value, not relative.\n            Use a property that gives the machine specific absolute path,\n            e.g. <code>${java.home}</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="systemPath", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String systemPath
	@xcore.lang.GenModel(documentation="4.0.0+\r\nLists a set of artifacts that should be excluded from this dependency\'s\n            artifact list when it comes to calculating transitive dependencies.")
	@xcore.lang.ExtendedMetaData(kind="element", name="exclusions", namespace="##targetNamespace")
	contains ExclusionsType exclusions
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Indicates the dependency is optional for use of this library. While the\n            version of the dependency will be taken into account for dependency calculation if the\n            library is used elsewhere, it will not be passed on transitively. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>false</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="optional", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String optional
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nSection for management of default dependency information for use in a group of\n        POMs.")
@xcore.lang.ExtendedMetaData(name="DependencyManagement", kind="elementOnly")
class DependencyManagement {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe dependencies specified here are not used until they are referenced in a\n            POM within the group. This allows the specification of a \"standard\" version for a\n            particular dependency.")
	@xcore.lang.ExtendedMetaData(kind="element", name="dependencies", namespace="##targetNamespace")
	contains DependenciesType3 dependencies
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nDeployment repository contains the information needed for deploying to the remote\n        repository, which adds {@code uniqueVersion} property to usual repository information for download.")
@xcore.lang.ExtendedMetaData(name="DeploymentRepository", kind="elementOnly")
class DeploymentRepository {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nWhether to assign snapshots a unique version comprised of the timestamp and\n            build number, or to use the same version each time, when deploying to repository")
	@xcore.lang.ExtendedMetaData(kind="element", name="uniqueVersion", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.Boolean uniqueVersion = "true"
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHow to handle downloading of releases from this repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="releases", namespace="##targetNamespace")
	contains RepositoryPolicy releases
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHow to handle downloading of snapshots from this repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="snapshots", namespace="##targetNamespace")
	contains RepositoryPolicy snapshots
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            A unique identifier for a repository. This is used to match the repository\n            to configuration in the <code>settings.xml</code> file, for example. Furthermore, the identifier is\n            used during POM inheritance and profile injection to detect repositories that should be merged.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="id", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] ^id
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHuman readable name of the repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The url of the repository, in the form <code>protocol://hostname/path</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] url
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The type of layout this repository uses for locating and storing artifacts -\n            can be <code>legacy</code> or <code>default</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="layout", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String layout = "default"
}

@xcore.lang.GenModel(documentation="3.0.0+\r\nInformation about one of the committers on this project.")
@xcore.lang.ExtendedMetaData(name="Developer", kind="elementOnly")
class Developer {
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe unique ID of the developer in the SCM.")
	@xcore.lang.ExtendedMetaData(kind="element", name="id", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String ^id
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe full name of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe email address of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="email", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String email
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe URL for the homepage of the contributor.")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe organization to which the contributor belongs.")
	@xcore.lang.ExtendedMetaData(kind="element", name="organization", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String organization
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe URL of the organization.")
	@xcore.lang.ExtendedMetaData(kind="element", name="organizationUrl", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String organizationUrl
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The roles the contributor plays in the project. Each role is described by a\n            <code>role</code> element, the body of which is a role name. This can also be used to\n            describe the contribution.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="roles", namespace="##targetNamespace")
	contains RolesType1 roles
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n              The timezone the contributor is in. Typically, this is a number in the range\n              <a href=\"http://en.wikipedia.org/wiki/UTC%E2%88%9212:00\">-12</a> to <a href=\"http://en.wikipedia.org/wiki/UTC%2B14:00\">+14</a>\n              or a valid time zone id like \"America/Montreal\" (UTC-05:00) or \"Europe/Paris\" (UTC+01:00).\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="timezone", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String timezone
	@xcore.lang.GenModel(documentation="3.0.0+\r\nProperties about the contributor, such as an instant messenger handle.")
	@xcore.lang.ExtendedMetaData(kind="element", name="properties", namespace="##targetNamespace")
	contains PropertiesType3 properties
}

