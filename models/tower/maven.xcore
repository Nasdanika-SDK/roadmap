@xcore.lang.GenModel(documentation="4.0.0+\r\nA repository contains the information needed for establishing connections with\n        remote repository.")
@xcore.lang.ExtendedMetaData(name="Repository", kind="elementOnly")
class Repository {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHow to handle downloading of releases from this repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="releases", namespace="##targetNamespace")
	contains RepositoryPolicy releases
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHow to handle downloading of snapshots from this repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="snapshots", namespace="##targetNamespace")
	contains RepositoryPolicy snapshots
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            A unique identifier for a repository. This is used to match the repository\n            to configuration in the <code>settings.xml</code> file, for example. Furthermore, the identifier is\n            used during POM inheritance and profile injection to detect repositories that should be merged.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="id", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] ^id
	@xcore.lang.GenModel(documentation="4.0.0+\r\nHuman readable name of the repository.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The url of the repository, in the form <code>protocol://hostname/path</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] url
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The type of layout this repository uses for locating and storing artifacts -\n            can be <code>legacy</code> or <code>default</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="layout", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String layout = "default"
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nRepository download policy.")
@xcore.lang.ExtendedMetaData(name="RepositoryPolicy", kind="elementOnly")
class RepositoryPolicy {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Whether to use this repository for downloading this type of artifact. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>true</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="enabled", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String enabled
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The frequency for downloading updates - can be\n            <code>always,</code>\n            <code>daily</code>\n            (default),\n            <code>interval:XXX</code>\n            (in minutes) or\n            <code>never</code>\n            (only if it doesn\'t exist locally).\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="updatePolicy", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String updatePolicy
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            What to do when verification of an artifact checksum fails. Valid values are\n            <code>ignore</code>\n            ,\n            <code>fail</code>\n            or\n            <code>warn</code>\n            (the default).\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="checksumPolicy", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String checksumPolicy
}

@xcore.lang.GenModel(documentation="3.0.0+\r\nThis element describes all of the classpath resources associated with a project\n        or unit tests.")
@xcore.lang.ExtendedMetaData(name="Resource", kind="elementOnly")
class Resource {
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            Describe the resource target path. The path is relative to the target/classes\n            directory (i.e. <code>${project.build.outputDirectory}</code>).\n            For example, if you want that resource to appear in a specific package\n            (<code>org.apache.maven.messages</code>), you must specify this\n            element with this value: <code>org/apache/maven/messages</code>.\n            This is not required if you simply put the resources in that directory\n            structure at the source, however.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="targetPath", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String targetPath
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            Whether resources are filtered to replace tokens with parameterised values or not.\n            The values are taken from the <code>properties</code> element and from the\n            properties in the files listed in the <code>filters</code> element. Note: While the type\n            of this field is <code>String</code> for technical reasons, the semantic type is actually\n            <code>Boolean</code>. Default value is <code>false</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="filtering", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String filtering
	@xcore.lang.GenModel(documentation="3.0.0+\r\nDescribe the directory where the resources are stored. The path is relative\n            to the POM.")
	@xcore.lang.ExtendedMetaData(kind="element", name="directory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String directory
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            A list of patterns to include, e.g. <code>**&#47;*.xml</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="includes", namespace="##targetNamespace")
	contains IncludesType includes
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            A list of patterns to exclude, e.g. <code>**&#47;*.xml</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="excludes", namespace="##targetNamespace")
	contains ExcludesType excludes
}

@xcore.lang.ExtendedMetaData(name="resources_._type", kind="elementOnly")
class ResourcesType {
	@xcore.lang.ExtendedMetaData(kind="element", name="resource", namespace="##targetNamespace")
	contains Resource[] resource
}

