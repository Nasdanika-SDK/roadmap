	contains MailingList[] mailingList
}

@xcore.lang.GenModel(documentation="3.0.0+\r\n\n        \n        The <code>&lt;project&gt;</code> element is the root of the descriptor.\n        The following table lists all of the possible child elements.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="Model", kind="elementOnly")
class Model {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Declares to which version of project descriptor this POM conforms to: <code>4.0.0</code> is the only\n            value supported by Maven 3.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="modelVersion", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] modelVersion
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe location of the parent project, if one exists. Values from the parent\n            project will be the default for this project if they are left unspecified. The location\n            is given as a group ID, artifact ID and version.",
		property="Editable", notify="false", children="false", createChild="false", propertySortChoices="true")
	@xcore.lang.ExtendedMetaData(kind="element", name="parent", namespace="##targetNamespace")
	contains Parent parent
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            A universally unique identifier for a project. It is normal to\n            use a fully-qualified package name to distinguish it from other\n            projects with a similar name (eg. <code>org.apache.maven</code>).\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="groupId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String groupId
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe identifier for this artifact that is unique within the group given by the\n            group ID. An artifact is something that is either produced or used by a project.\n            Examples of artifacts produced by Maven for a project include: JARs, source and binary\n            distributions, and WARs.")
	@xcore.lang.ExtendedMetaData(kind="element", name="artifactId", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] artifactId
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe current version of the artifact produced by this project.")
	@xcore.lang.ExtendedMetaData(kind="element", name="version", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String version
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The type of artifact this project produces, for example <code>jar</code>\n              <code>war</code>\n              <code>ear</code>\n              <code>pom</code>.\n            Plugins can create their own packaging, and\n            therefore their own packaging types,\n            so this list does not contain all possible types.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="packaging", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.String packaging = "jar"
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe full name of the project. If not specified, the artifactId will be used.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="3.0.0+\r\nA detailed description of the project, used by Maven whenever it needs to\n            describe the project, such as on the web site. While this element can be specified as\n            CDATA to enable the use of HTML tags within the description, it is discouraged to allow\n            plain text representation. If you need to modify the index page of the generated web\n            site, you are able to specify your own instead of adjusting this text.")
	@xcore.lang.ExtendedMetaData(kind="element", name="description", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String description
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            The URL to the project\'s homepage.\n            <br><b>Default value is</b>: parent value [+ path adjustment] + (artifactId or project.directory property), or just parent value if\n            project\'s <code>child.project.url.inherit.append.path=\"false\"</code>\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe year of the project\'s inception, specified with 4 digits. This value is\n            used when generating copyright notices as well as being informational.")
	@xcore.lang.ExtendedMetaData(kind="element", name="inceptionYear", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String inceptionYear
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThis element describes various attributes of the organization to which the\n            project belongs. These attributes are utilized when documentation is created (for\n            copyright notices and links).")
	@xcore.lang.ExtendedMetaData(kind="element", name="organization", namespace="##targetNamespace")
	contains Organization organization
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            \n            This element describes all of the licenses for this project.\n            Each license is described by a <code>license</code> element, which\n            is then described by additional elements.\n            Projects should only list the license(s) that applies to the project\n            and not the licenses that apply to dependencies.\n            If multiple licenses are listed, it is assumed that the user can select\n            any of them, not that they must accept all.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="licenses", namespace="##targetNamespace")
	contains LicensesType licenses
	@xcore.lang.GenModel(documentation="3.0.0+\r\nDescribes the committers of a project.")
	@xcore.lang.ExtendedMetaData(kind="element", name="developers", namespace="##targetNamespace")
	contains DevelopersType developers
	@xcore.lang.GenModel(documentation="3.0.0+\r\nDescribes the contributors to a project that are not yet committers.")
	@xcore.lang.ExtendedMetaData(kind="element", name="contributors", namespace="##targetNamespace")
	contains ContributorsType contributors
	@xcore.lang.GenModel(documentation="3.0.0+\r\nContains information about a project\'s mailing lists.")
	@xcore.lang.ExtendedMetaData(kind="element", name="mailingLists", namespace="##targetNamespace")
	contains MailingListsType mailingLists
	@xcore.lang.GenModel(documentation="4.0.0+\r\nDescribes the prerequisites in the build environment for this project.")
	@xcore.lang.ExtendedMetaData(kind="element", name="prerequisites", namespace="##targetNamespace")
	contains Prerequisites prerequisites
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe modules (sometimes called subprojects) to build as a part of this\n            project. Each module listed is a relative path to the directory containing the module.\n            To be consistent with the way default urls are calculated from parent, it is recommended\n            to have module names match artifact ids.")
	@xcore.lang.ExtendedMetaData(kind="element", name="modules", namespace="##targetNamespace")
	contains ModulesType1 modules
