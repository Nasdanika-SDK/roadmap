	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe official url for the license text.")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
