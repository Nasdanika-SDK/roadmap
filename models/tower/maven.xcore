    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.maven

import org.nasdanika.models.nxcore.StringIdentity
import org.nasdanika.models.nxcore.StringToStringMapEntry
import org.nasdanika.models.threat.Asset

import org.eclipse.emf.ecore.EFeatureMapEntry
import org.eclipse.emf.ecore.EStringToStringMapEntry
import org.eclipse.emf.ecore.xml.^type.Boolean
import org.eclipse.emf.ecore.xml.^type.String

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika


@xcore.lang.GenModel(documentation="4.0.0+\r\nThe conditions within the build runtime environment which will trigger the\n        automatic inclusion of the build profile. Multiple conditions can be defined, which must\n        be all satisfied to activate the profile.\n      ")
@xcore.lang.ExtendedMetaData(name="Activation", kind="elementOnly")
class Activation {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nIf set to true, this profile will be active unless another profile in this\n            pom is activated using the command line -P option or by one of that profile\'s\n            activators.")
	@xcore.lang.ExtendedMetaData(kind="element", name="activeByDefault", namespace="##targetNamespace")
	unsettable org.eclipse.emf.ecore.xml.^type.Boolean activeByDefault = "false"
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            Specifies that this profile will be activated when a matching JDK is detected.\n            For example, <code>1.4</code> only activates on JDKs versioned 1.4,\n            while <code>!1.4</code> matches any JDK that is not version 1.4. Ranges are supported too:\n            <code>[1.5,)</code> activates when the JDK is 1.5 minimum.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="jdk", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String jdk
	@xcore.lang.GenModel(documentation="4.0.0+\r\nSpecifies that this profile will be activated when matching operating system\n            attributes are detected.")
	@xcore.lang.ExtendedMetaData(kind="element", name="os", namespace="##targetNamespace")
	contains ActivationOS os
	@xcore.lang.GenModel(documentation="4.0.0+\r\nSpecifies that this profile will be activated when this property is\n            specified.")
	@xcore.lang.ExtendedMetaData(kind="element", name="property", namespace="##targetNamespace")
	contains ActivationProperty property
	@xcore.lang.GenModel(documentation="4.0.0+\r\nSpecifies that this profile will be activated based on existence of a file.")
	@xcore.lang.ExtendedMetaData(kind="element", name="file", namespace="##targetNamespace")
	contains ActivationFile file
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nThis is the file specification used to activate the profile. The <code>missing</code> value\n        is the location of a file that needs to exist, and if it doesn\'t, the profile will be\n        activated. On the other hand, <code>exists</code> will test for the existence of the file and if it is\n        there, the profile will be activated.<br>\n        Variable interpolation for these file specifications is limited to <code>${project.basedir}</code>,\n        <code>${project.rootDirectory}</code>, system properties and user properties.")
@xcore.lang.ExtendedMetaData(name="ActivationFile", kind="elementOnly")
class ActivationFile {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe name of the file that must be missing to activate the\n          profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="missing", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String missing
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe name of the file that must exist to activate the profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="exists", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String exists
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nThis is an activator which will detect an operating system\'s attributes in order\n        to activate its profile.")
@xcore.lang.ExtendedMetaData(name="ActivationOS", kind="elementOnly")
class ActivationOS {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The name of the operating system to be used to activate the profile. This must be an exact match\n            of the <code>${os.name}</code> Java property, such as <code>Windows XP</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String name
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The general family of the OS to be used to activate the profile, such as\n            <code>windows</code> or <code>unix</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="family", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String family
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe architecture of the operating system to be used to activate the\n          profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="arch", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String arch
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe version of the operating system to be used to activate the\n          profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="version", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String version
}

@xcore.lang.GenModel(documentation="4.0.0+\r\nThis is the property specification used to activate a profile. If the value field\n        is empty, then the existence of the named property will activate the profile, otherwise it\n        does a case-sensitive match against the property value as well.")
@xcore.lang.ExtendedMetaData(name="ActivationProperty", kind="elementOnly")
class ActivationProperty {
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe name of the property to be used to activate a profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="name", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String[1] name
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe value of the property required to activate a profile.")
	@xcore.lang.ExtendedMetaData(kind="element", name="value", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String value
}

@xcore.lang.GenModel(documentation="3.0.0+\r\n\n        \n        The <code>&lt;build&gt;</code> element contains informations required to build the project.\n        Default values are defined in Super POM.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="Build", kind="elementOnly")
class Build {
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            This element specifies a directory containing the source of the project. The\n            generated build system will compile the sources from this directory when the project is\n            built. The path given is relative to the project descriptor.\n            The default value is <code>src/main/java</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="sourceDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String sourceDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            This element specifies a directory containing the script sources of the\n            project. This directory is meant to be different from the sourceDirectory, in that its\n            contents will be copied to the output directory in most cases (since scripts are\n            interpreted rather than compiled).\n            The default value is <code>src/main/scripts</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="scriptSourceDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String scriptSourceDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            This element specifies a directory containing the unit test source of the\n            project. The generated build system will compile these directories when the project is\n            being tested. The path given is relative to the project descriptor.\n            The default value is <code>src/test/java</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="testSourceDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String testSourceDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            The directory where compiled application classes are placed.\n            The default value is <code>target/classes</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="outputDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String outputDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            The directory where compiled test classes are placed.\n            The default value is <code>target/test-classes</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="testOutputDirectory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String testOutputDirectory
	@xcore.lang.GenModel(documentation="4.0.0+\r\nA set of build extensions to use from this project.")
	@xcore.lang.ExtendedMetaData(kind="element", name="extensions", namespace="##targetNamespace")
	contains ExtensionsType extensions
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe default goal to execute when none is specified for\n            the project. In a multi-module build, only the default goal of the top-level\n            project is relevant. That is, the default goals of child modules are ignored.\n            Multiple goals can be separated by whitespace.")
	@xcore.lang.ExtendedMetaData(kind="element", name="defaultGoal", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String defaultGoal
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            This element describes all of the classpath resources such as properties\n            files associated with a project. These resources are often included in the final\n            package.\n            The default value is <code>src/main/resources</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="resources", namespace="##targetNamespace")
	contains ResourcesType1 resources
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            This element describes all of the classpath resources such as properties\n            files associated with a project\'s unit tests.\n            The default value is <code>src/test/resources</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="testResources", namespace="##targetNamespace")
	contains TestResourcesType1 testResources
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            The directory where all files generated by the build are placed.\n            The default value is <code>target</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="directory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String directory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The filename (excluding the extension, and with no path information) that\n            the produced artifact will be called.\n            The default value is <code>${artifactId}-${version}</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="finalName", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String finalName
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe list of filter properties files that are used when filtering is enabled.")
	@xcore.lang.ExtendedMetaData(kind="element", name="filters", namespace="##targetNamespace")
	contains FiltersType1 filters
	@xcore.lang.GenModel(documentation="4.0.0+\r\nDefault plugin information to be made available for reference by projects\n            derived from this one. This plugin configuration will not be resolved or bound to the\n            lifecycle unless referenced. Any local configuration for a given plugin will override\n            the plugin\'s entire definition here.")
	@xcore.lang.ExtendedMetaData(kind="element", name="pluginManagement", namespace="##targetNamespace")
	contains PluginManagement pluginManagement
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe list of plugins to use.")
	@xcore.lang.ExtendedMetaData(kind="element", name="plugins", namespace="##targetNamespace")
	contains PluginsType1 plugins
}

@xcore.lang.GenModel(documentation="3.0.0+\r\nBuild configuration in a profile.")
@xcore.lang.ExtendedMetaData(name="BuildBase", kind="elementOnly")
class BuildBase {
	@xcore.lang.GenModel(documentation="3.0.0+\r\nThe default goal to execute when none is specified for\n            the project. In a multi-module build, only the default goal of the top-level\n            project is relevant. That is, the default goals of child modules are ignored.\n            Multiple goals can be separated by whitespace.")
	@xcore.lang.ExtendedMetaData(kind="element", name="defaultGoal", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String defaultGoal
	@xcore.lang.GenModel(documentation="3.0.0+\r\n\n            This element describes all of the classpath resources such as properties\n            files associated with a project. These resources are often included in the final\n            package.\n            The default value is <code>src/main/resources</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="resources", namespace="##targetNamespace")
	contains ResourcesType resources
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            This element describes all of the classpath resources such as properties\n            files associated with a project\'s unit tests.\n            The default value is <code>src/test/resources</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="testResources", namespace="##targetNamespace")
	contains TestResourcesType testResources
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            The directory where all files generated by the build are placed.\n            The default value is <code>target</code>.\n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="directory", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String directory
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The filename (excluding the extension, and with no path information) that\n            the produced artifact will be called.\n            The default value is <code>${artifactId}-${version}</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="finalName", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String finalName
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe list of filter properties files that are used when filtering is enabled.")
	@xcore.lang.ExtendedMetaData(kind="element", name="filters", namespace="##targetNamespace")
	contains FiltersType filters
	@xcore.lang.GenModel(documentation="4.0.0+\r\nDefault plugin information to be made available for reference by projects\n            derived from this one. This plugin configuration will not be resolved or bound to the\n            lifecycle unless referenced. Any local configuration for a given plugin will override\n            the plugin\'s entire definition here.")
	@xcore.lang.ExtendedMetaData(kind="element", name="pluginManagement", namespace="##targetNamespace")
	contains PluginManagement pluginManagement
	@xcore.lang.GenModel(documentation="4.0.0+\r\nThe list of plugins to use.")
	@xcore.lang.ExtendedMetaData(kind="element", name="plugins", namespace="##targetNamespace")
	contains PluginsType plugins
}

@xcore.lang.GenModel(documentation="4.0.0+\r\n\n        \n        The <code>&lt;CiManagement&gt;</code> element contains informations required to the\n        continuous integration system of the project.\n        \n      ")
@xcore.lang.ExtendedMetaData(name="CiManagement", kind="elementOnly")
class CiManagement {
	@xcore.lang.GenModel(documentation="4.0.0+\r\n\n            \n            The name of the continuous integration system, e.g. <code>continuum</code>.\n            \n          ")
	@xcore.lang.ExtendedMetaData(kind="element", name="system", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String system
	@xcore.lang.GenModel(documentation="4.0.0+\r\nURL for the continuous integration system used by the project if it has a web\n            interface.")
	@xcore.lang.ExtendedMetaData(kind="element", name="url", namespace="##targetNamespace")
	org.eclipse.emf.ecore.xml.^type.String url
	@xcore.lang.GenModel(documentation="4.0.0+\r\nConfiguration for notifying developers/users when a build is unsuccessful,\n            including user information and notification mode.")
	@xcore.lang.ExtendedMetaData(kind="element", name="notifiers", namespace="##targetNamespace")
	contains NotifiersType notifiers
}

@xcore.lang.ExtendedMetaData(name="configuration_._type", kind="elementOnly")
class ConfigurationType {
	@xcore.lang.ExtendedMetaData(kind="elementWildcard", wildcards="##any", name=":0", processing="skip")
	EFeatureMapEntry[] any
}

