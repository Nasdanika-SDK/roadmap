@Ecore(nsURI="https://ciso.models.nasdanika.org", nsPrefix="org.nasdanika.models.ciso")
@GenModel(
	modelDirectory="/model/src-gen",
    featureDelegation="Dynamic",
    complianceLevel="21",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.ciso

import org.nasdanika.models.governance.ModelElement
import org.nasdanika.models.governance.GovernedElement
import org.nasdanika.models.governance.GovernanceProgram
import org.nasdanika.models.governance.Level
import org.nasdanika.models.governance.Control
import org.nasdanika.models.governance.Risk
import org.nasdanika.models.governance.Waiver
import org.nasdanika.models.governance.Assessment
import org.nasdanika.models.threat.Asset
import org.nasdanika.models.threat.Threat
import org.nasdanika.models.threat.Weakness

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* ---- Program (root container) ---- */

/*
 * A security program: the operational record a CISO owns. Strategy and
 * compliance live in the referenced governance program; threats live in
 * threat models over the same assets; this class holds what happens while
 * the program runs. A GovernedElement itself: the program is audited,
 * carries risks, and holds waivers like anything it governs.
 */
class SecurityProgram extends GovernedElement {
    /* Markdown charter: mission, scope, authority, reporting line. */
    String charter
    /* The governance program the security program operates: frameworks, policies, controls, risk register. */
    refers GovernanceProgram governance
    contains Incident[] incidents
    contains Vulnerability[] vulnerabilities
    contains AwarenessCampaign[] campaigns
    contains ContinuityPlan[] continuityPlans
    contains ThirdParty[] thirdParties
    contains SecurityMetric[] metrics
}

/* ---- Incident response ---- */

/* NIST SP 800-61 lifecycle as status, not as separate phase objects. */
enum IncidentStatus {
    DETECTED
    TRIAGED
    CONTAINED
    ERADICATED
    RECOVERED
    CLOSED
}

/*
 * A security incident: a materialized threat. Response tasks live in the
 * work model; who commanded the response comes from the role model. What
 * is modeled here is the record auditors, regulators, and post-incident
 * reviews need.
 */
class Incident extends ModelElement {
    Level severity
    IncidentStatus status
    Date detected
    Date contained
    Date closed
    /* Reportable to a regulator or counterparty: GDPR Art. 33, SEC materiality, contractual notification. */
    boolean reportable
    /* Modeled threats this incident realized; empty on a closed incident is a threat modeling finding. */
    refers Threat[] realizes
    refers Asset[] affected
    /* Vulnerabilities exploited, when known. */
    refers Vulnerability[] exploited
    /* Risk register entries created or re-scored in response. */
    refers Risk[] elevates
    /* Corrective controls introduced or strengthened in response. */
    refers Control[] correctiveActions
    contains TimelineEntry[] timeline
    /* Markdown post-incident review. */
    String lessonsLearned
}

/* One entry in an incident timeline; the evidentiary spine of the record. */
class TimelineEntry extends ModelElement {
    Date timestamp
    /* Acting party; typed role engagements come from the role model. */
    String actor
}

/* ---- Vulnerability management ---- */

enum VulnerabilityStatus {
    OPEN
    IN_REMEDIATION
    REMEDIATED
    /* Risk-accepted; must reference a governance waiver. */
    ACCEPTED
    FALSE_POSITIVE
}

/*
 * A vulnerability: the instance of a weakness in a concrete asset. The
 * unit of vulnerability management, distinct from the Weakness (class of
 * flaw, CWE) and the Threat (the attack that exploits it).
 */
class Vulnerability extends ModelElement {
    /* External reference, e.g. "CVE-2026-1234"; internal findings may have none. */
    String reference
    /* The class of flaw, from the threat model's weakness vocabulary. */
    refers Weakness weakness
    /* CVSS or internal score. */
    double score
    Level severity
    VulnerabilityStatus status
    /* On a known-exploited list (e.g. CISA KEV) or observed exploited; drives the SLA. */
    boolean knownExploited
    Date discovered
    /* Remediation SLA. */
    Date due
    /* Detection origin: scanner, pentest, bug bounty, coordinated disclosure. */
    String discoveredBy
    refers Asset[] affected
    /* Required when status is ACCEPTED; a status field alone is not risk acceptance. */
    refers Waiver waiver
}

/* ---- Awareness ---- */

enum CampaignKind {
    TRAINING
    PHISHING_SIMULATION
    COMMUNICATION
}

/*
 * An awareness activity: training, a phishing simulation, a communication
 * push. The human layer of the control catalog; the directive controls it
 * operationalizes live in governance.
 */
class AwarenessCampaign extends ModelElement {
    CampaignKind kind
    Date starts
    Date ends
    /* Target audience; typed role engagements come from the role model. */
    String audience
    /* Outcome measures: completion rate, phish click rate. */
    refers SecurityMetric[] outcomes
}

/* ---- Resilience ---- */

/*
 * A business continuity / disaster recovery plan over a set of assets.
 * Objectives are stated here; whether they are met is demonstrated by
 * exercises.
 */
class ContinuityPlan extends ModelElement {
    refers Asset[] scope
    /* Recovery time objective, minutes. */
    int rtoMinutes
    /* Recovery point objective, minutes. */
    int rpoMinutes
    contains Exercise[] exercises
}

enum ExerciseKind {
    TABLETOP
    WALKTHROUGH
    SIMULATION
    FAILOVER
}

/*
 * A test of a continuity plan. "Did we do a good job" is a governance
 * Assessment over the same scope; findings and remediation live there,
 * not here.
 */
class Exercise extends ModelElement {
    ExerciseKind kind
    Date date
    refers Assessment assessment
}

/* ---- Third parties ---- */

/*
 * A vendor or partner in the security program's scope. Extends
 * GovernedElement, so control applications (questionnaire responses as
 * evidence), risks, waivers, and assessment scoping come for free;
 * third-party risk management is governance applied to an external
 * subject, not a separate discipline.
 */
class ThirdParty extends GovernedElement {
    Level criticality
    /* Level of access to data and systems; drives assessment depth and cadence. */
    Level access
    /* Services provided. */
    String services
    Date contractExpires
}

/* ---- Metrics ---- */

enum TargetDirection {
    AT_LEAST
    AT_MOST
}

/*
 * A security metric: mean time to detect, patch latency against SLA,
 * phish click rate, fraction of incidents predicted by threat models.
 * The current value is read from telemetry via the location URI, not
 * stored: telemetry as code, the same posture as Evidence.location in
 * governance. Board reporting is a generated view over these.
 */
class SecurityMetric extends ModelElement {
    String unit
    double target
    TargetDirection direction
    /* URI of the producing query or dashboard. */
    String location
}

