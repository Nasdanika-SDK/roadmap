@Ecore(nsURI="https://architecture.models.nasdanika.org", nsPrefix="org.nasdanika.models.architecture")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.architecture

import org.nasdanika.models.work.Workable
import org.nasdanika.models.nxcore.ModelElement

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

/* Base (ModelElement, Property) is imported from the tower rather than
 * redefined; collapses into nxcore on base extraction. */

/* ---- Kinds (instance data, not subclasses) ---- */

/*
 * A kind of element: person, software system, container, component,
 * data store, capability, business function. Catalogs define notations:
 * C4, ArchiMate, TOGAF layers are ElementKind sets, so adopting a
 * notation is authoring, not metamodel change. superType enables
 * taxonomy: a microservice is a kind of container.
 */
class ElementKind extends ModelElement {
    refers ElementKind superType
}

/*
 * A kind of relationship: uses, calls, reads, deploys to, realizes,
 * depends on. inverseName labels the other direction ("is used by").
 */
class RelationshipKind extends ModelElement {
    refers RelationshipKind superType
    String inverseName
}

/* ---- Elements ---- */

/*
 * Common base for defined and referenced elements, so containment,
 * relationships, and views treat local and federated architecture
 * uniformly. Extends Workable: the tower delivers work, governance,
 * lifecycle, access control, and role engagement to every element.
 */
abstract class AbstractElement extends Workable {
    /* Outgoing relationships; the source of a relationship is its container. */
    contains Relationship[] outgoingRelationships
    
    // TODO - computed incomingRelationships - as in nxcore

}

/*
 * The one structural class: a system, a container, a component, a person,
 * a domain. Contains elements (decomposition; C4 levels, domain
 * hierarchies, and the old model's Domain/Composite classes are all this
 * one containment) and is typed by kind.
 */
class Element extends AbstractElement {
    refers ElementKind kind
    contains AbstractElement[] elements
}

/*
 * A citation of an element defined and published in another model:
 * federation. A cross-system architecture view is a model of references
 * plus the relationships between them.
 */
class ElementReference extends AbstractElement {
    /* URI of the referenced element in the published model. */
    String uri
}

/* ---- Relationships ---- */

/*
 * A reified, directed relationship, contained in its source. Being a
 * ModelElement it carries kind, properties, and documentation; being
 * able to carry other relationships it is also the tunnel: a VPN
 * carrying app connections, an HTTPS session carrying API calls, an
 * event bus carrying flows. Layered views (logical flows over physical
 * channels) are queries over carries.
 */
class Relationship extends ModelElement {
    refers RelationshipKind kind
    refers AbstractElement target
    /* Relationships this one carries: the tunnel/aggregation mechanism. */
    refers Relationship[] carries
}

